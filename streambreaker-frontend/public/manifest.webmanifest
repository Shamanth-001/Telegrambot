{
  "name": "StreamBreaker",
  "short_name": "StreamBreaker",
  "description": "Movies and series: trailers, where to watch, and download links.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0b0d",
  "theme_color": "#0b0b0d",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Movies", "url": "/movies", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Series", "url": "/series", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "My List", "url": "/watchlist", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
